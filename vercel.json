{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "alfred.barronroth.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "redirects": [
    {
      "source": "/cubby/:path*",
      "destination": "https://cubby.homes/:path*",
      "permanent": true
    },
    {
      "source": "/cubby",
      "destination": "https://cubby.homes",
      "permanent": true
    },
    {
      "source": "/maitre-d/:path*",
      "destination": "https://maitred.fun/:path*",
      "permanent": true
    },
    {
      "source": "/maitre-d",
      "destination": "https://maitred.fun",
      "permanent": true
    }
  ]
}
